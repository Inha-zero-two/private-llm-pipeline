# 복사해서 .env.local(개발) 또는 .env.production.local(배포 빌드)로 만들고 값을 채운다.
# *.local 파일은 git에 올라가지 않는다.

# mock: 브라우저 안 가짜 앱 서버 (기본값) / http: 실제 앱 서버에 연결
VITE_API_MODE=mock

# ---- 개발: localhost 웹 + 로컬에서 띄운 앱 서버 ----
# 개발 서버가 /api 요청을 넘길 앱 서버 주소
API_URL=http://localhost:8000

# ---- 운영: CloudFront 웹 + 로컬 LLM과 같은 곳의 앱 서버 ----
# 앱 서버 주소. https:// 로 시작해야 한다 (아니면 빌드가 멈춘다). 빌드할 때 박히므로 바꾸면 다시 빌드한다.
# 서버는 웹 주소에 CORS를 열어야 한다.
# 비우면 웹과 같은 주소의 /api로 보낸다 (CloudFront에서 /api만 앱 서버로 넘길 때). 개발에서는 비워 둔다.
# 예: VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

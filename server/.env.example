# server/.env 로 복사해 값을 채웁니다. .env는 git에 올라가지 않습니다.
# 환경변수가 있으면 환경변수가 우선합니다.

# 프론티어 모델(학교 Bedrock 게이트웨이) — 설계 5.3 FrontierClient
FRONTIER_API_KEY=
FRONTIER_BASE_URL=https://bedrock.nxtcloud.kr/v1
# 단가가 등록된 모델: bedrock-gpt-6-luna, bedrock-haiku, bedrock-gpt-6.1-sol
FRONTIER_MODEL=bedrock-gpt-6-luna

# 채팅·실행 기록 SQLite DB 파일 — 설계 6.3 ChatManager
# 비우면 server/data/chat.sqlite3. 상대 경로는 server/ 기준
CHAT_DB_PATH=

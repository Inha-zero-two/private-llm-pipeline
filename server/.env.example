# server/.env 로 복사해 값을 채웁니다. .env는 git에 올라가지 않습니다.
# 환경변수가 있으면 환경변수가 우선합니다.

# 프론티어 모델(OpenAI Responses API) — 설계 5.3 FrontierClient
FRONTIER_API_KEY=
FRONTIER_BASE_URL=https://api.openai.com/v1
# 현재 단가·캐시 요율이 등록된 모델
FRONTIER_MODEL=gpt-6-luna
# true: 필요할 때 모델이 웹 검색 여부 판단(tool_choice=auto), false: 검색 도구 미제공
FRONTIER_WEB_SEARCH=true

# 채팅·실행 기록 SQLite DB 파일 — 설계 6.3 ChatManager
# 비우면 server/data/chat.sqlite3. 상대 경로는 server/ 기준
CHAT_DB_PATH=

{
	# Porkbun에서 받은 인증서를 사용하고 HTTP 80 자동 리다이렉트는 열지 않습니다.
	auto_https off
}

https://satisshin.top:4000 {
	tls /etc/satisshin/tls/current/fullchain.pem /etc/satisshin/tls/current/privkey.pem

	@management path /slots /slots/* /metrics /lora-adapters /lora-adapters/*
	@props_changes {
		path /props /props/*
		method POST PUT PATCH DELETE
	}
	route {
		# 팀 API 키로도 전역 관리 기능은 외부에서 사용할 수 없습니다.
		respond @management 404
		respond @props_changes 404
		reverse_proxy 127.0.0.1:4001 {
			health_uri /health
			health_status 200
			health_interval 5s
			health_timeout 2s
			transport http {
				dial_timeout 2s
			}

			# llama-server가 모델 로딩 중 등으로 직접 돌려준 장애 응답도 통일합니다.
			@unavailable status 502 503 504
			handle_response @unavailable {
				header Content-Type application/json
				respond `{"error":{"code":"llm_service_unavailable","message":"LLM service is unavailable."}}` 503
			}
		}
	}

	# GPU 미감지·서버 중지·연결 실패 시에도 HTTPS와 이 응답은 유지됩니다.
	# 구버전 Caddy에서도 동작하도록 상태 코드 인자 없이 내부 오류를 처리합니다.
	handle_errors {
		header Content-Type application/json
		respond `{"error":{"code":"llm_service_unavailable","message":"LLM service is unavailable."}}` 503
	}
}
